---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import AdminApp from '../components/app/AdminApp.astro';
import DemoBanner from '../components/DemoBanner.astro';
import { site } from '../data/site';
---

<Layout
  title={`Live demo | ${site.name}`}
  description="A working sample of the platform we build: commerce, CRM and support, growth, inventory and production, field service, internal team tools and an AI assistant, all on one database."
>
  <Nav />
  {/* Full bleed under the site nav: the admin is the page, not a screenshot inside it. */}
  <main id="main" tabindex="-1" class="demo-main">
    {/* Says up front that this is sample software, and that the real one is built to fit. */}
    <DemoBanner />
    <AdminApp />
  </main>
</Layout>

<style>
  /* No Footer and no container: the app owns the viewport below the nav, the way the real one would. */
  .demo-main { display: block; }
</style>
