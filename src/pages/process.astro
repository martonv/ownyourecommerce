---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';

// 24x24 stroke paths, drawn inline so they take the page's colour tokens.
const icons = {
  sales: 'M4 18l5-6 4 3 6-8M19 7h2v2',
  warehouse: 'M4 7l8-4 8 4-8 4zM4 7v10l8 4V11M20 7v10l-8 4',
  production: 'M3 20h18M5 20V10l5 3v-3l5 3v-3l4 2.5V20',
  support: 'M4 5h16v11H9l-5 4zM8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01',
  finance: 'M6 3h9l3.5 3.5V21H6zM15 3v3.5h3.5M9.5 11.5h5M9.5 15h5M9.5 18h3',
  leadership: 'M9 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM3 20c.7-3.2 3.1-5 6-5s5.3 1.8 6 5M16 4.3a3.5 3.5 0 010 6.4M18 15.2c1.6.7 2.6 2.3 3 4.8',
};

const teams = [
  {
    team: 'Sales and wholesale',
    icon: icons.sales,
    maps: 'How quotes, pricing tiers and net terms work today, and what reps have to ask someone else to answer.',
  },
  {
    team: 'Warehouse',
    icon: icons.warehouse,
    maps: 'How stock is counted, where it lives, what gets picked first, and which numbers nobody trusts.',
  },
  {
    team: 'Production',
    icon: icons.production,
    maps: 'What triggers a build, how materials are checked, and where a job waits longer than it should.',
  },
  {
    team: 'Customer support',
    icon: icons.support,
    maps: 'The questions that come in daily, what the team has to open three tabs to answer, and what should never reach a person.',
  },
  {
    team: 'Finance',
    icon: icons.finance,
    maps: 'Which records have to match the books, what gets exported by hand, and when the month-end reconciliation gets painful.',
  },
  {
    team: 'Leadership',
    icon: icons.leadership,
    maps: 'The numbers you run the business on, how long they take to produce, and how much of that is someone building a spreadsheet.',
  },
];

const steps = [
  {
    title: 'Stack review',
    free: true,
    body:
      "A 45-minute call with your team. We map out your business's software dependencies and see what we can replace with a custom solution to save you money and time.",
  },
  {
    title: 'Team discovery',
    body: 'We sit with each team that touches an order and write down how the work actually happens, edge cases included, rather than how the software says it should.',
  },
  {
    title: 'Scope and price',
    body: 'A written scope, a fixed price and a timeline, including which of your current tools we replace and which we connect to. Nothing starts until you agree to all three.',
  },
  {
    title: 'Build and migrate',
    body: 'Weekly demos of working software. We migrate products, customers, orders and history while your current systems keep running.',
  },
  {
    title: 'Launch',
    body: 'We switch over when it is tested and your team is working in the new system, with the old one still available until the counts match.',
  },
  {
    title: 'Maintain and evolve',
    body: 'New features, integrations and performance work shipped by the team that built it. Monthly retainer or project by project, your call.',
  },
];
---

<Layout
  title="Process | Own Your eCommerce"
  description="We talk to every team that touches an order, map how the work really happens, then build one system around it and connect whatever you want to keep."
>
  <Nav />
  <main id="main" tabindex="-1" class="boxed">
    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Process</p>
          <h2>Fixed scope. Fixed price. Weekly demos.</h2>
          <p class="lead">
            Six steps from the first call to software your team works in. You know the price and the
            timeline before anything is built.
          </p>
        </div>

        <ol class="steps" data-reveal>
          {steps.map((s, i) => (
            <li class="step">
              <div class="node">
                <span class="num">{i + 1}</span>
                <span class="line" aria-hidden="true">
                  <svg viewBox="0 0 10 10" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 1.5L7 5l-4 3.5" />
                  </svg>
                </span>
              </div>
              <h3>
                {s.title}
                {s.free && <span class="chip">Free</span>}
              </h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section-subtle">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Discovery</p>
          <h2>Who we sit with, and what we map.</h2>
          <p class="lead">
            Every team sees a different part of the same order. The gaps between those views are
            usually where the money and the hours go.
          </p>
        </div>

        <ul class="teams">
          {teams.map((t) => (
            <li class="team" data-reveal>
              <span class="team-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d={t.icon} />
                </svg>
              </span>
              <h3>{t.team}</h3>
              <p>{t.maps}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="container keep">
        <div class="section-head" data-reveal>
          <p class="eyebrow">What you keep</p>
          <h2>Nothing gets replaced to prove a point.</h2>
          <p class="lead">
            If a tool earns its place, it stays and we connect to it through its API: your accounting,
            your email platform, your 3PL, your CRM. We tell you honestly which ones are worth keeping
            and which are costing you more than they return.
          </p>
        </div>
        <a href="/#contact" class="btn btn-primary" data-reveal>Book a stack review</a>
      </div>
    </section>

    <CtaBand
      title="Start with the map."
      body="Forty-five minutes with your team, and you leave knowing where your systems disagree and what it would take to fix it."
    />
  </main>
  <Footer />
</Layout>

<style>
  /* ---- Discovery tiles ---- */
  .teams {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .team {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }
  .team:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm, 0 6px 20px -12px rgba(0, 0, 0, 0.28));
  }
  .team-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .team h3 { font-size: 1.0625rem; }
  .team p { font-size: 0.9375rem; }

  /* ---- Horizontal flow chart ---- */
  .steps {
    --flow-cols: 6;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--flow-cols), minmax(0, 1fr));
    gap: 0 18px;
  }
  .step { display: flex; flex-direction: column; gap: 8px; }
  /* the node row carries the badge and the connector that runs to the next step */
  .node { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .step:first-child .num {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: var(--btn-accent-fg, #fff);
  }
  .line {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 2px;
    color: var(--border-strong);
    /* reaches across the grid gap so the chart reads as one continuous flow */
    margin-right: -18px;
  }
  .line::before {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    background: currentColor;
  }
  .line svg { flex: none; }
  /* no connector off the end of a row, or off the last step */
  .step:nth-child(6n) .line,
  .step:last-child .line { display: none; }

  .step h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 1rem;
  }
  .step p { font-size: 0.875rem; }
  .chip {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--btn-accent-bg);
    color: var(--btn-accent-fg);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .keep { display: flex; flex-direction: column; align-items: flex-start; }
  .keep .section-head { margin-bottom: 24px; }

  @media (max-width: 1180px) {
    .steps { --flow-cols: 3; gap: 32px 18px; }
    .step:nth-child(6n) .line { display: flex; }
    .step:nth-child(3n) .line { display: none; }
  }
  @media (max-width: 900px) {
    .teams { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 680px) {
    .teams { grid-template-columns: 1fr; }
    .steps { --flow-cols: 2; }
    .step:nth-child(3n) .line { display: flex; }
    .step:nth-child(2n) .line { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .team { transition: none; }
    .team:hover { transform: none; }
  }
</style>
