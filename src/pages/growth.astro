---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';

const agents = [
  {
    title: 'A shopping assistant on your catalog',
    body: 'Answers product, stock, shipping and order questions from your real data, and hands the conversation to your team the moment it should.',
    works: 'Works the chat queue overnight',
  },
  {
    title: 'A copywriter that knows the product',
    body: 'Drafts product descriptions, emails and ad variants in your brand voice from the catalog itself, ready for someone to approve.',
    works: 'Clears the backlog of unwritten listings',
  },
  {
    title: 'Triage for every inbound message',
    body: 'Chat, SMS and email arrive in one inbox already sorted, with the customer\'s orders and history attached to the thread.',
    works: 'Cuts the time before a reply',
  },
  {
    title: 'Routing for internal tickets',
    body: 'A raised ticket gets its queue, its priority and the work order it belongs to, without anyone triaging the list by hand.',
    works: 'Keeps the shop floor moving',
  },
  {
    title: 'Risk scoring before you ship',
    body: 'Risky orders are held for review using address checks, processor signals and your own rules, instead of being discovered at chargeback.',
    works: 'Protects the margin you already earned',
  },
  {
    title: 'Restock and demand prompts',
    body: 'Reorder points and open demand are watched against live stock, so purchase orders get raised before a bestseller runs out.',
    works: 'Stops the stockout that costs the sale',
  },
];

const convert = [
  {
    title: 'A/B testing measured in orders',
    body: 'Test headlines, layouts, offers and prices on real traffic, then ship the winner. Results are counted in revenue, not clicks.',
  },
  {
    title: 'Reviews, loyalty and referrals',
    body: 'Photo reviews, product questions, points and referral codes that live in your own system instead of another monthly app.',
  },
  {
    title: 'Email and SMS that react to real events',
    body: 'Abandoned cart, back in stock, post-purchase and win-back flows triggered by actual orders and stock levels.',
  },
  {
    title: 'Gift cards, pre-orders and bundles',
    body: 'Store credit, deposits on back-orders, and bundles that draw down the right components from the right warehouse.',
  },
];
---

<Layout
  title="Growth | Own Your eCommerce"
  description="Integrations that put your catalog where buyers are, and agents that work the queues your team never gets to, all on the same data as your orders."
>
  <Nav />
  <main id="main" tabindex="-1" class="boxed">
    <section class="section section-subtle page-top">
      <span class="page-bg growth-chart" aria-hidden="true">
        <svg viewBox="0 0 1200 420" preserveAspectRatio="none" focusable="false">
          {[1, 2, 3, 4].map((i) => (
            <line class="rule" x1="0" x2="1200" y1={i * 84} y2={i * 84} />
          ))}
          <polygon class="area" points="0,420 0,392 60,380 120,360 180,370 240,342 300,352 360,322 420,300 480,314 540,284 600,266 660,276 720,244 780,220 840,234 900,200 960,174 1020,188 1080,150 1140,120 1200,86 1200,420" />
          <polyline class="line" points="0,392 60,380 120,360 180,370 240,342 300,352 360,322 420,300 480,314 540,284 600,266 660,276 720,244 780,220 840,234 900,200 960,174 1020,188 1080,150 1140,120 1200,86" />
        </svg>
      </span>
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Agents</p>
          <h2>Work that happens without anyone starting it.</h2>
          <p class="lead">
            Each one reads your own catalog, stock and orders, acts inside rules you set, and hands
            over to a person when it is not sure.
          </p>
        </div>

        <ul class="agents">
          {agents.map((a) => (
            <li class="agent" data-reveal>
              <div>
                <h3>{a.title}</h3>
                <p>{a.body}</p>
              </div>
              <span class="works">{a.works}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Convert and keep</p>
          <h2>The revenue you already have, kept.</h2>
        </div>

        <ul class="grid two">
          {convert.map((c) => (
            <li class="card" data-reveal>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBand
      title="Find the revenue your stack is leaking."
      body="We map where your catalog, stock and customer data stop short today, and what connecting them would be worth."
    />
  </main>
  <Footer />
</Layout>

<style>
  /* Page motif: a faded drawing behind the opening section, masked so it dissolves before the
     content below it. Decorative only, so it is hidden from assistive tech and never catches a click. */
  .page-top { position: relative; overflow: hidden; }
  .page-top > .container { position: relative; z-index: 1; }
  .page-bg {
    position: absolute;
    top: 0;
    bottom: 0;
    /* Held to the content frame rather than the section box, so the motif stops at the rails
       instead of running out across the dotted gutters to the edge of the window. */
    left: 50%;
    width: min(var(--max-w), 100%);
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, #000 6%, rgba(0, 0, 0, 0.55) 55%, transparent 94%);
    mask-image: linear-gradient(180deg, #000 6%, rgba(0, 0, 0, 0.55) 55%, transparent 94%);
  }
  .page-bg svg { width: 100%; height: 100%; display: block; }

  /* The line is stretched to the section, so the stroke is kept at a true width. */
  .page-bg .line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    opacity: 0.3;
    vector-effect: non-scaling-stroke;
  }
  .page-bg .area { fill: var(--accent-soft); opacity: 0.6; }
  /* Held to the open band above the cards: stretched over the whole section the climb sits behind
     them and only a corner of it is ever visible. */
  .growth-chart { bottom: auto; height: clamp(300px, 46vw, 430px); }
  .page-bg .rule {
    stroke: var(--border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .grid.two { grid-template-columns: repeat(2, 1fr); }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.18s var(--ease);
  }
  .card:hover { border-color: var(--border-strong); }
  .card h3 { font-size: 1.0625rem; }
  .card p { font-size: 0.9375rem; }
  .agents {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .agent {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }
  .agent h3 { font-size: 1.0625rem; margin-bottom: 4px; }
  .agent p { font-size: 0.9375rem; max-width: 64ch; }
  .works {
    align-self: center;
    padding: 4px 12px;
    border-radius: 0;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 680px) {
    .grid, .grid.two { grid-template-columns: 1fr; }
    .agent { grid-template-columns: 1fr; gap: 10px; }
    .works { align-self: start; }
  }
</style>
