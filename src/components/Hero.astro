---
import HeroDemo from './hero/HeroDemo';
---

<section class="hero" id="top">
  <div class="dots" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="eyebrow" data-reveal>For companies running their store, CRM and inventory in separate tools</p>

    <h1 data-reveal>Building the new standard for eCommerce businesses.</h1>

    <p class="lead" data-reveal>
      We replace the patchwork of storefront, CRM and inventory tools with one system: orders,
      customers, inventory and production on a single database. Built around how your team works.
      Paid for once, owned by you.
    </p>

    <div class="hero-cta" data-reveal>
      <a href="#contact" class="btn btn-primary">Book a stack review</a>
      <a href="#product" class="btn btn-secondary">Try the live demo <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <p class="micro" data-reveal>Free 45-minute review. You leave with a map of your stack either way.</p>
  </div>

  <div class="container frame-wrap">
    {/* Hydrates only on wide screens; narrow ones keep the server-rendered still. */}
    <HeroDemo client:media="(min-width: 1024px)" />
  </div>
</section>

<div class="stack-strip">
  <div class="container">
    <p>Replaces or connects to: Shopify · HubSpot · Fishbowl · QuickBooks · ShipStation</p>
  </div>
</div>

<style>
  .hero {
    position: relative;
    padding: clamp(56px, 7vw, 96px) 0 0;
    scroll-margin-top: 64px;
    background: var(--bg);
  }

  /* a very faint dot grid, faded out around the headline */
  .dots {
    position: absolute;
    inset: 0 0 auto;
    height: 560px;
    background-image: radial-gradient(var(--border-strong) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 30%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 30%, #000 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .hero-inner h1 { max-width: 24ch; }
  .hero-inner .lead { max-width: 56ch; }

  .hero-cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
  }
  .hero-cta .arrow { transition: transform 0.18s var(--ease); display: inline-block; }
  .hero-cta a:hover .arrow { transform: translateX(2px); }

  .micro {
    font-size: 0.8125rem;
    color: var(--text-muted);
    max-width: 48ch;
  }

  /* the frame overlaps the band below it */
  .frame-wrap {
    position: relative;
    margin-top: 64px;
    margin-bottom: -120px;
  }
  .frame-wrap :global(.hero-frame) {
    max-width: 1100px;
    margin: 0 auto;
  }

  .stack-strip {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    padding: 164px 0 40px;
  }
  .stack-strip p {
    margin: 0 auto;
    max-width: none;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .frame-wrap { margin-top: 48px; margin-bottom: -60px; }
    .stack-strip { padding: 100px 0 32px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta .arrow { transition: none; }
  }
</style>
