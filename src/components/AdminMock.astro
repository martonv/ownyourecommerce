---
const stats = [
  { label: 'Total sales',  value: '$12,485', delta: '+18%', up: true },
  { label: 'Sessions',     value: '3,241',   delta: '+12%', up: true },
  { label: 'Orders',       value: '142',     delta: '+7%',  up: true },
  { label: 'Conversion',   value: '4.3%',    delta: '+0.4', up: true },
];

const orders = [
  { id: '#3041', customer: 'Sarah Chen',       items: '2 items', total: '$189.00', payment: 'Paid',     fulfillment: 'Fulfilled',   date: 'Today, 2:42 pm' },
  { id: '#3040', customer: 'Marcus Johnson',   items: '1 item',  total: '$42.50',  payment: 'Paid',     fulfillment: 'Unfulfilled', date: 'Today, 1:18 pm' },
  { id: '#3039', customer: 'Emma Rodriguez',   items: '4 items', total: '$284.00', payment: 'Paid',     fulfillment: 'Fulfilled',   date: 'Today, 11:04 am' },
  { id: '#3038', customer: 'David Park',       items: '1 item',  total: '$97.00',  payment: 'Refunded', fulfillment: 'Returned',    date: 'Yesterday' },
  { id: '#3037', customer: 'Olivia Bennett',   items: '3 items', total: '$156.50', payment: 'Paid',     fulfillment: 'Fulfilled',   date: 'Yesterday' },
  { id: '#3036', customer: 'Jamal Williams',   items: '2 items', total: '$78.00',  payment: 'Pending',  fulfillment: 'Unfulfilled', date: 'Yesterday' },
];

const tasks = [
  { count: 6,  label: 'Orders to fulfill', tone: 'green' },
  { count: 2,  label: 'Payments to capture', tone: 'amber' },
  { count: 3,  label: 'Reviews to respond to', tone: 'blue' },
];

const customers = [
  { name: 'Sarah Chen',     loc: 'Brooklyn, NY',     spent: '$1,240', orders: 9 },
  { name: 'Emma Rodriguez', loc: 'Austin, TX',       spent: '$986',   orders: 6 },
  { name: 'Olivia Bennett', loc: 'Toronto, ON',      spent: '$742',   orders: 5 },
  { name: 'Liam O\'Connor', loc: 'Boston, MA',       spent: '$612',   orders: 4 },
];

const nav = [
  { key: 'home',       label: 'Home',       active: true },
  { key: 'orders',     label: 'Orders',     badge: 6 },
  { key: 'products',   label: 'Products' },
  { key: 'customers',  label: 'Customers' },
  { key: 'content',    label: 'Content' },
  { key: 'analytics',  label: 'Analytics' },
  { key: 'marketing',  label: 'Marketing' },
  { key: 'discounts',  label: 'Discounts' },
];
---

<section class="section admin-section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">What we build</span>
      <h2>An admin that fits <span class="text-accent">your business</span></h2>
      <p class="lead" style="text-align:center;">
        A custom home dashboard your team actually wants to use. Orders, customers, fulfillment,
        and the workflows specific to how you operate. No app store. No clutter. All yours.
      </p>
    </div>

    <div class="admin-frame" data-reveal>
      <div class="admin-top">
        <div class="store-pill">
          <div class="store-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="14" height="14">
              <rect width="32" height="32" rx="8" fill="#16a34a"/>
              <path d="M9 11 L9 21 L13 21 L13 17 L19 17 L19 21 L23 21 L23 11 L19 11 L19 13 L13 13 L13 11 Z" fill="#fff"/>
            </svg>
          </div>
          <span class="store-name">Your Store</span>
        </div>

        <div class="admin-search">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <path d="M21 21l-4.3-4.3" stroke-linecap="round"/>
          </svg>
          <span>Search orders, products, customers…</span>
          <kbd>⌘K</kbd>
        </div>

        <div class="admin-tools">
          <button class="admin-icon" aria-label="Notifications">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M6 8a6 6 0 1112 0v5l1.5 3h-15L6 13z" stroke-linejoin="round"/>
              <path d="M10 19a2 2 0 004 0" stroke-linecap="round"/>
            </svg>
            <span class="dot-red"></span>
          </button>
          <div class="admin-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="9" r="3.5"/>
              <path d="M5 20c.8-3.4 3.8-5.5 7-5.5s6.2 2.1 7 5.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="admin-body">
        <aside class="admin-side">
          <nav class="admin-nav" aria-label="Admin">
            {nav.map((n) => (
              <a href="#" class={`nav-item ${n.active ? 'is-active' : ''}`}>
                <span class="nav-ico" aria-hidden="true">
                  {n.key === 'home' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M4 11l8-7 8 7v9a1 1 0 01-1 1h-4v-6h-6v6H5a1 1 0 01-1-1z" stroke-linejoin="round"/>
                    </svg>
                  )}
                  {n.key === 'orders' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M6 7h12l-1 12H7zM9 7V5a3 3 0 016 0v2" stroke-linejoin="round"/>
                    </svg>
                  )}
                  {n.key === 'products' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M4 7l8-4 8 4-8 4zM4 7v10l8 4V11M20 7v10l-8 4" stroke-linejoin="round"/>
                    </svg>
                  )}
                  {n.key === 'customers' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <circle cx="12" cy="9" r="3.5"/>
                      <path d="M5 20c.8-3.4 3.8-5.5 7-5.5s6.2 2.1 7 5.5" stroke-linecap="round"/>
                    </svg>
                  )}
                  {n.key === 'content' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <rect x="4" y="4" width="16" height="16" rx="2"/>
                      <path d="M8 9h8M8 13h8M8 17h5" stroke-linecap="round"/>
                    </svg>
                  )}
                  {n.key === 'analytics' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M5 19V9M10 19V5M15 19v-7M20 19v-3" stroke-linecap="round"/>
                    </svg>
                  )}
                  {n.key === 'marketing' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M4 11l14-7v16zM4 11v4h2l1 4h3l-1-4" stroke-linejoin="round"/>
                    </svg>
                  )}
                  {n.key === 'discounts' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                      <path d="M4 13l8 8 9-9V4h-8z" stroke-linejoin="round"/>
                      <circle cx="15" cy="9" r="1.2" fill="currentColor"/>
                    </svg>
                  )}
                </span>
                <span class="nav-lab">{n.label}</span>
                {n.badge && <span class="nav-badge">{n.badge}</span>}
              </a>
            ))}
          </nav>

          <div class="side-foot">
            <div class="status-pill">
              <span class="status-dot"></span>
              Live · 99.999%
            </div>
          </div>
        </aside>

        <div class="admin-main">
          <div class="greeting">
            <div>
              <h3>Good afternoon</h3>
              <span class="muted-text">Here's what's happening in your store today.</span>
            </div>
            <div class="greeting-actions">
              <button class="ghost-pill">Last 7 days</button>
              <button class="primary-pill">Add product</button>
            </div>
          </div>

          <div class="stats">
            {stats.map((s) => (
              <div class="stat">
                <div class="s-label">{s.label}</div>
                <div class="s-value">{s.value}</div>
                <div class={`s-delta ${s.up ? 'up' : 'down'}`}>
                  <svg viewBox="0 0 16 16" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M4 10l4-4 4 4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {s.delta}
                </div>
                <svg class="spark" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 22 L10 18 L20 20 L30 14 L40 16 L50 10 L60 12 L70 6 L80 8 L90 4 L100 2"
                    fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            ))}
          </div>

          <div class="dash-grid">
            <div class="card orders-card">
              <div class="card-head">
                <div>
                  <div class="card-title">Recent orders</div>
                  <div class="card-sub">Last 24 hours</div>
                </div>
                <a href="#" class="link">View all</a>
              </div>
              <div class="orders-table" role="table">
                <div class="otr head" role="row">
                  <div>Order</div><div>Customer</div><div>Total</div><div>Payment</div><div>Fulfillment</div>
                </div>
                {orders.map((o) => (
                  <div class="otr" role="row">
                    <div class="oid">{o.id}</div>
                    <div class="ocust">
                      <span class="cname">{o.customer}</span>
                      <span class="csub">{o.items} · {o.date}</span>
                    </div>
                    <div class="ototal">{o.total}</div>
                    <div>
                      <span class={`badge p-${o.payment.toLowerCase()}`}>
                        <span class="bdot"></span>
                        {o.payment}
                      </span>
                    </div>
                    <div>
                      <span class={`badge f-${o.fulfillment.toLowerCase()}`}>
                        <span class="bdot"></span>
                        {o.fulfillment}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="dash-right">
              <div class="card tasks-card">
                <div class="card-head">
                  <div class="card-title">To do</div>
                </div>
                <ul class="tasks">
                  {tasks.map((t) => (
                    <li>
                      <span class={`task-count ${t.tone}`}>{t.count}</span>
                      <span class="task-label">{t.label}</span>
                      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path d="M6 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="card customers-card">
                <div class="card-head">
                  <div>
                    <div class="card-title">Top customers</div>
                    <div class="card-sub">Last 30 days</div>
                  </div>
                </div>
                <ul class="customers">
                  {customers.map((c) => (
                    <li>
                      <div class="avatar">{c.name.split(' ').map((p) => p[0]).slice(0,2).join('')}</div>
                      <div class="c-meta">
                        <div class="c-name">{c.name}</div>
                        <div class="c-sub">{c.loc} · {c.orders} orders</div>
                      </div>
                      <div class="c-spent">{c.spent}</div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .admin-section {
    background: var(--bg);
    padding: clamp(8px, 1.5vw, 16px) 0 clamp(80px, 10vw, 120px);
  }

  .admin-frame {
    border: 1px solid var(--border-strong);
    background: var(--bg-subtle);
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 30px 80px -30px var(--accent-glow),
      0 16px 50px -16px rgba(0,0,0,0.18);
  }

  /* ====== Top bar ====== */
  .admin-top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .store-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 6px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .store-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .store-name { font-size: 0.82rem; font-weight: 600; color: var(--text); }

  .admin-search {
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(520px, 100%);
    margin: 0 auto;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 7px 10px;
    color: var(--text-tertiary);
    font-size: 0.82rem;
  }
  .admin-search span { flex: 1; }
  .admin-search kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--bg-muted);
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .admin-tools {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .admin-icon {
    position: relative;
    width: 32px; height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .admin-icon .dot-red {
    position: absolute;
    top: 5px; right: 6px;
    width: 7px; height: 7px;
    background: var(--danger);
    border-radius: 50%;
    border: 2px solid var(--surface);
  }
  .admin-avatar {
    width: 30px; height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    letter-spacing: -0.01em;
  }

  /* ====== Body ====== */
  .admin-body {
    display: grid;
    grid-template-columns: 218px 1fr;
    background: var(--bg-subtle);
  }

  /* ====== Sidebar ====== */
  .admin-side {
    border-right: 1px solid var(--border);
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 480px;
    background: var(--bg-subtle);
  }
  .admin-nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .nav-item {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 7px;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    transition: background 0.15s var(--ease), color 0.15s var(--ease);
  }
  .nav-item:hover { background: var(--bg-muted); color: var(--text); }
  .nav-item.is-active {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
  }
  .nav-ico { display: inline-flex; }
  .nav-ico svg { width: 16px; height: 16px; }
  .nav-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--bg-muted);
    color: var(--text);
  }
  .nav-item.is-active .nav-badge {
    background: var(--accent);
    color: #fff;
  }

  .side-foot { margin-top: auto; }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.74rem;
    padding: 6px 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-secondary);
  }
  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 22%, transparent);
  }

  /* ====== Main ====== */
  .admin-main {
    padding: 18px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .greeting {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .greeting h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .muted-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .greeting-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ghost-pill, .primary-pill {
    height: 32px;
    padding: 0 12px;
    border-radius: 7px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: default;
  }
  .primary-pill {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* Stats row */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .stat {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    overflow: hidden;
  }
  .s-label {
    font-size: 0.74rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .s-value {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-top: 4px;
  }
  .s-delta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 6px;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--success);
  }
  .s-delta.down { color: var(--danger); }
  .s-delta.down svg { transform: rotate(180deg); }
  .spark {
    position: absolute;
    right: 10px;
    bottom: 6px;
    width: 70px;
    height: 22px;
    color: var(--accent);
    opacity: 0.55;
  }

  /* Dashboard grid */
  .dash-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 12px;
  }
  .dash-right {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .card-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
  }
  .card-sub {
    font-size: 0.76rem;
    color: var(--text-tertiary);
    margin-top: 2px;
  }
  .link {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 500;
  }

  /* Orders table */
  .orders-table { display: flex; flex-direction: column; }
  .otr {
    display: grid;
    grid-template-columns: 0.7fr 1.5fr 0.8fr 1fr 1.1fr;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 0.84rem;
  }
  .otr:last-child { border-bottom: 0; }
  .otr.head {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--bg-subtle);
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .oid { font-family: var(--font-mono); color: var(--text); font-size: 0.8rem; }
  .ocust { display: flex; flex-direction: column; min-width: 0; }
  .cname { color: var(--text); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .csub { color: var(--text-tertiary); font-size: 0.72rem; margin-top: 2px; }
  .ototal { color: var(--text); font-weight: 500; }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 500;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .badge .bdot { width: 6px; height: 6px; border-radius: 50%; }
  .p-paid, .f-fulfilled {
    background: color-mix(in srgb, var(--success) 14%, transparent);
    color: var(--success);
    border-color: color-mix(in srgb, var(--success) 28%, transparent);
  }
  .p-paid .bdot, .f-fulfilled .bdot { background: var(--success); }
  .p-pending {
    background: color-mix(in srgb, var(--warn) 16%, transparent);
    color: var(--warn);
    border-color: color-mix(in srgb, var(--warn) 30%, transparent);
  }
  .p-pending .bdot { background: var(--warn); }
  .p-refunded, .f-returned {
    background: var(--bg-muted);
    color: var(--text-secondary);
    border-color: var(--border-strong);
  }
  .p-refunded .bdot, .f-returned .bdot { background: var(--text-tertiary); }
  .f-unfulfilled {
    background: color-mix(in srgb, var(--warn) 12%, transparent);
    color: var(--warn);
    border-color: color-mix(in srgb, var(--warn) 26%, transparent);
  }
  .f-unfulfilled .bdot { background: var(--warn); }

  /* Tasks */
  .tasks { list-style: none; margin: 0; padding: 8px; display: flex; flex-direction: column; gap: 2px; }
  .tasks li {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 8px;
    cursor: default;
    color: var(--text-secondary);
  }
  .tasks li:hover { background: var(--bg-subtle); color: var(--text); }
  .task-count {
    width: 30px; height: 30px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    color: #fff;
