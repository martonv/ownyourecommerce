---
/**
 * The hero product shot: the real admin, not a mock of it.
 *
 * It renders the same AdminApp the /demo page uses, so the home page can never drift from the
 * product again. Only the handful of screens the loop visits are rendered, and the whole thing is
 * inert — a visitor clicks "Try the live demo" to get the interactive one.
 *
 * The app is laid out at a fixed size and scaled to fit, so type and hairlines stay crisp at any
 * width and the layout never reflows as the container changes.
 */
import ProductFrame from './ProductFrame.astro';
import AdminApp from './app/AdminApp.astro';
import { TENANT } from './app/seed';

const VIEWS = ['dashboard', 'orders', 'production', 'inbox'];
---

<div class="hero-admin" data-hero-admin>
  <ProductFrame class="hero-frame" label={TENANT.domain}>
    <div class="ha-scale" data-ha-scale>
      <div class="ha-canvas" data-ha-canvas>
        <AdminApp only={VIEWS} still={true} />
      </div>
      <span class="ha-cursor" data-ha-cursor aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20">
          <path d="M5 2l14 9-6.2 1.3L10 19z" fill="#fff" stroke="#0e0e11" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </ProductFrame>
</div>

<script>
  const host = document.querySelector<HTMLElement>('[data-hero-admin]');

  if (host) {
    const CANVAS_W = 1320;
    const CANVAS_H = 810;
    const scaleBox = host.querySelector<HTMLElement>('[data-ha-scale]')!;
    const canvas = host.querySelector<HTMLElement>('[data-ha-canvas]')!;
    const cursor = host.querySelector<HTMLElement>('[data-ha-cursor]')!;

    // Lay the app out at a fixed size and scale it, rather than letting it reflow to the container.
    const fit = () => {
      const scale = scaleBox.clientWidth / CANVAS_W;
      canvas.style.transform = `scale(${scale})`;
      scaleBox.style.setProperty('--ha-scale', String(scale));
    };
    fit();
    new ResizeObserver(fit).observe(scaleBox);

    const steps: { view: string; hold: number }[] = [
      { view: 'dashboard', hold: 3400 },
      { view: 'orders', hold: 3200 },
      { view: 'production', hold: 3400 },
      { view: 'inbox', hold: 3000 },
    ];

    let i = 0;
    let timer = 0;
    let inView = false;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const stop = () => {
      window.clearTimeout(timer);
      timer = 0;
    };

    /**
     * Replay the panel's entrance. A CSS animation only runs once per element, so the class is
     * removed and a reflow forced before re-adding it, otherwise revisiting a screen is silent.
     */
    const enter = (view: string) => {
      const panel = canvas.querySelector<HTMLElement>(`[data-oa-view="${view}"]`);
      if (!panel || reduced.matches) return;
      panel.classList.remove('ha-enter');
      void panel.offsetWidth;
      panel.classList.add('ha-enter');
      countUp(panel);
    };

    /** Stat tiles count toward their real value, so the numbers feel live rather than printed. */
    const countUp = (panel: HTMLElement) => {
      panel.querySelectorAll<HTMLElement>('.oa-tile-value').forEach((el) => {
        const finalText = el.dataset.final ?? (el.dataset.final = el.textContent!.trim());
        const parts = finalText.match(/^(\D*?)([\d][\d,]*(?:\.\d+)?)(.*)$/);
        if (!parts) return;
        const [, prefix, digits, suffix] = parts;
        const target = Number(digits.replace(/,/g, ''));
        if (!Number.isFinite(target)) return;
        const decimals = (digits.split('.')[1] ?? '').length;
        const from = target * 0.78;
        const started = performance.now();
        const DUR = 900;

        const frame = (now: number) => {
          const t = Math.min(1, (now - started) / DUR);
          const eased = 1 - Math.pow(1 - t, 3);
          const value = from + (target - from) * eased;
          el.textContent =
            prefix +
            value.toLocaleString('en-US', {
              minimumFractionDigits: decimals,
              maximumFractionDigits: decimals,
            }) +
            suffix;
          if (t < 1) requestAnimationFrame(frame);
          else el.textContent = finalText;
        };
        requestAnimationFrame(frame);
      });
    };

    // The pointer travels to the sidebar entry, then the app's own router does the rest, so the
    // loop drives the real UI instead of a copy of it.
    const goto = (index: number) => {
      const step = steps[index];
      const link = canvas.querySelector<HTMLElement>(`[data-oa-link="${step.view}"]`);
      if (!link) return;

      // A module inside a collapsed group has no box to aim at, so open it before measuring.
      const group = link.closest<HTMLElement>('[data-oa-group]');
      if (group && group.dataset.open !== 'true') {
        group.dataset.open = 'true';
        group.querySelector('[data-oa-group-btn]')?.setAttribute('aria-expanded', 'true');
      }

      requestAnimationFrame(() => {
        const box = link.getBoundingClientRect();
        const frame = canvas.getBoundingClientRect();
        const scale = Number(scaleBox.style.getPropertyValue('--ha-scale')) || 1;
        if (!box.width) return;
        // positions are measured on screen, then converted back into unscaled canvas space
        const x = (box.left - frame.left) / scale + box.width / scale - 24;
        const y = (box.top - frame.top) / scale + box.height / scale / 2;

        cursor.style.transform = `translate(${x}px, ${y}px)`;
        window.setTimeout(() => {
          cursor.dataset.click = 'true';
          link.click();
          enter(step.view);
          window.setTimeout(() => (cursor.dataset.click = 'false'), 260);
        }, 520);
      });
    };

    const tick = () => {
      stop();
      if (!inView || document.hidden || reduced.matches) return;
      timer = window.setTimeout(() => {
        i = (i + 1) % steps.length;
        goto(i);
        tick();
      }, steps[i].hold);
    };

    new IntersectionObserver(
      (entries) => {
        const wasIn = inView;
        inView = entries.some((e) => e.isIntersecting);
        if (inView && !wasIn) enter(steps[i].view);
        if (inView) tick();
        else stop();
      },
      { threshold: 0.25 }
    ).observe(host);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : tick()));
    reduced.addEventListener('change', () => (reduced.matches ? stop() : tick()));
  }
</script>

<style>
  .hero-admin :global(.hero-frame) { max-width: 1100px; margin: 0 auto; }

  /* aspect-ratio reserves the height up front, so scaling never shifts the page */
  .ha-scale {
    position: relative;
    aspect-ratio: 1320 / 810;
    overflow: hidden;
    /* a picture of the product: clicks belong to the demo page */
    pointer-events: none;
    user-select: none;
  }
  .ha-canvas {
    width: 1320px;
    height: 810px;
    transform-origin: top left;
  }

  /* the app fills the fixed canvas instead of sizing itself to the viewport */
  .ha-canvas :global(.oa-shell) {
    height: 100%;
    min-height: 0;
    max-height: none;
    border-top: 0;
  }

  .ha-cursor {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    transform: translate(300px, 300px);
    transition: transform 0.72s cubic-bezier(0.22, 0.61, 0.36, 1);
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    /* scales with the canvas so the pointer keeps its on-screen size */
    scale: calc(1 / var(--ha-scale, 1) * var(--ha-scale, 1));
    will-change: transform;
  }
  .ha-cursor::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    transform: scale(0.4);
  }
  .ha-cursor[data-click='true']::after {
    animation: ha-ripple 0.5s var(--ease);
  }
  @keyframes ha-ripple {
    0% { opacity: 0.45; transform: scale(0.4); }
    100% { opacity: 0; transform: scale(1.6); }
  }

  /* Panel contents rise in on every switch, a beat behind the click. */
  .ha-canvas :global(.ha-enter) > * {
    animation: ha-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .ha-canvas :global(.ha-enter) > *:nth-child(2) { animation-delay: 0.05s; }
  .ha-canvas :global(.ha-enter) > *:nth-child(3) { animation-delay: 0.1s; }
  .ha-canvas :global(.ha-enter) > *:nth-child(4) { animation-delay: 0.16s; }
  .ha-canvas :global(.ha-enter) > *:nth-child(5) { animation-delay: 0.22s; }
  .ha-canvas :global(.ha-enter) > *:nth-child(n + 6) { animation-delay: 0.28s; }
  /* the tiles inside a row cascade across, not together */
  .ha-canvas :global(.ha-enter) .oa-tile {
    animation: ha-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .ha-canvas :global(.ha-enter) .oa-tile:nth-child(2) { animation-delay: 0.09s; }
  .ha-canvas :global(.ha-enter) .oa-tile:nth-child(3) { animation-delay: 0.15s; }
  .ha-canvas :global(.ha-enter) .oa-tile:nth-child(4) { animation-delay: 0.21s; }
  .ha-canvas :global(.ha-enter) .oa-tile:nth-child(5) { animation-delay: 0.27s; }
  /* table rows wipe down behind them */
  .ha-canvas :global(.ha-enter) .oa-table tbody tr {
    animation: ha-row 0.42s ease-out backwards;
  }
  .ha-canvas :global(.ha-enter) .oa-table tbody tr:nth-child(2) { animation-delay: 0.05s; }
  .ha-canvas :global(.ha-enter) .oa-table tbody tr:nth-child(3) { animation-delay: 0.09s; }
  .ha-canvas :global(.ha-enter) .oa-table tbody tr:nth-child(4) { animation-delay: 0.13s; }
  .ha-canvas :global(.ha-enter) .oa-table tbody tr:nth-child(5) { animation-delay: 0.17s; }
  .ha-canvas :global(.ha-enter) .oa-table tbody tr:nth-child(n + 6) { animation-delay: 0.21s; }

  @keyframes ha-rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes ha-row {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .ha-cursor { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ha-cursor { display: none; }
    .ha-canvas :global(.ha-enter) > *,
    .ha-canvas :global(.ha-enter) .oa-tile,
    .ha-canvas :global(.ha-enter) .oa-table tbody tr { animation: none; }
  }
</style>
