---

<section class="section growth" id="growth">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Prebuilt growth stack</span>
      <h2>Marketing, sales, and support, <span class="text-accent">ready on day one</span></h2>
      <p class="lead">
        Prebuilt modules that plug into your store, inventory, and CRM from launch. Pick the ones you need, we tune them
        to your brand, and they're yours with no app subscriptions.
      </p>
    </div>

    {groups.map((group) => (
      <div class="gr-group" data-reveal>
        <h3 class="gr-group-title">{group.title}</h3>
        <ul class="gr-grid">
          {group.modules.map((m) => (
            <li class="gr-card">
              <div class="gr-head">
                <span class="gr-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d={m.icon} />
                  </svg>
                </span>
                <h4>{m.title}</h4>
              </div>
              <p>{m.body}</p>
              <ul class="gr-tags">{m.tags.map((t) => <li>{t}</li>)}</ul>
              {m.demo && (
                <a href="#demo" class="gr-link" data-demo-open={m.demo}>
                  See it in the demo
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}

    <p class="gr-note" data-reveal>
      AI features run on your own AI provider account, so usage is billed to you directly with no markup.
    </p>
  </div>
</section>

<style>
  .growth { background: var(--bg); }

  .gr-group + .gr-group { margin-top: 36px; }
  .gr-group-title {
    margin-bottom: 14px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .gr-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .gr-card {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .gr-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow); }
  /* icon and title share a line instead of stacking */
  .gr-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .gr-icon {
    width: 32px;
    height: 32px;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    border: 1px solid var(--accent-border);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .gr-card h4 { font-size: 1rem; line-height: 1.3; }
  .gr-card p { font-size: 0.86rem; line-height: 1.55; }
  .gr-tags {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .gr-tags li {
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-muted);
    font-size: 0.72rem;
    color: var(--text-secondary);
  }
  .gr-link {
    margin-top: auto;
    padding-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--text);
  }
  .gr-link svg { color: var(--accent); transition: transform 0.18s var(--ease); }
  .gr-link:hover svg { transform: translateX(2px); }
  .gr-note {
    margin-top: 24px;
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 1080px) {
    .gr-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .gr-grid { grid-template-columns: 1fr; }
  }
</style>
