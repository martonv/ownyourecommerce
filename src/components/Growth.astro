        icon: 'M12 21a9 9 0 100-18 9 9 0 000 18zM12 16a4 4 0 100-8 4 4 0 000 8z',
        body: "Meta, Google, TikTok, Pinterest, and Snapchat events sent from your server, so ad platforms still see conversions, always within the shopper's consent choice.",
        tags: ['Conversions API', 'Consent-aware'],
        demo: 'marketing',
      },
    ],
  },
  {
    title: 'Sell everywhere',
    modules: [
      {
        title: 'Social commerce',
        icon: 'M6 7h12l-1 12H7zM9 7V5a3 3 0 016 0v2',
        body: 'TikTok Shop, Instagram, Facebook, and YouTube catalogs synced with your stock, with their orders landing in the same queue as your site.',
        tags: ['TikTok Shop', 'Instagram and Facebook'],
        demo: 'marketing',
      },
      {
        title: 'International selling',
        icon: 'M12 21a9 9 0 100-18 9 9 0 000 18zM3 12h18M12 3c2.5 2.8 3.8 5.8 3.8 9s-1.3 6.2-3.8 9c-2.5-2.8-3.8-5.8-3.8-9S9.5 5.8 12 3z',
        body: 'Local currencies, translated storefronts, and duties and taxes calculated at checkout, so international shoppers see the full price up front.',
        tags: ['Multi-currency', 'Duties at checkout'],
      },
      {
        title: 'Affiliates and influencers',
        icon: 'M10 14a4 4 0 005.66 0l3-3a4 4 0 00-5.66-5.66l-1 1M14 10a4 4 0 00-5.66 0l-3 3a4 4 0 005.66 5.66l1-1',
        body: 'Referral links, creator codes, and commission tracking, with payouts calculated from real orders that were not returned.',
        tags: ['Creator codes', 'Payout reports'],
      },
      {
        title: 'Email and SMS flows',
