  {
    title: 'Get found',
    modules: [
      {
        title: 'AI marketing studio',
        icon: 'M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4zM18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z',
        body: 'Product descriptions, emails, and ad copy in your brand voice, plus customer segments that update themselves.',
        tags: ['Brand voice', 'Auto segments'],
        demo: 'marketing',
      },
      {
        title: 'SEO and AEO',
        icon: 'M11 18a7 7 0 100-14 7 7 0 000 14zM21 21l-5-5',
        body: 'Fast pages, structured data, and answer-ready content, so you rank on Google and get recommended by ChatGPT, Perplexity, and Google AI Overviews.',
        tags: ['Schema markup', 'llms.txt'],
        demo: 'marketing',
      },
      {
        title: 'Google Ads and Merchant Center',
        icon: 'M4 13l8 8 9-9V4h-8zM16 8h.01',
