        demo: 'inbox',
      },
      {
        title: 'Custom shipping',
        icon: 'M3 7h11v9H3zM14 11h4l3 3v2h-7zM7 20a2 2 0 110-4 2 2 0 010 4zM17 20a2 2 0 110-4 2 2 0 010 4z',
