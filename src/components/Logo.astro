  <path class="oye-dot" d="M3174 1110V838H3446V1110Z" />
</svg>

<style>
  /* Outlines copied from brand/oye-logo-black.svg. Read brand/BRAND.md before changing. */
  .oye-logo {
    display: block;
    flex: none;
  }
  .oye-letters { fill: currentColor; }
  .oye-dot { fill: var(--oye-dot, #16a34a); }
</style>
