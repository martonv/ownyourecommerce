---
interface Props {
  /** Rendered height in px. Width follows the logo's 2.17:1 aspect ratio. */
  height?: number;
  class?: string;
  /** Accessible name. Pass "" when a surrounding link already has a label. */
  label?: string;
}

const { height = 28, class: className, label = 'oye' } = Astro.props;
const width = Math.round((height * 3446) / 1590);
---

<svg
  class:list={['oye-logo', className]}
  viewBox="0 0 3446 1590"
  width={width}
  height={height}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  shape-rendering="geometricPrecision"
>
