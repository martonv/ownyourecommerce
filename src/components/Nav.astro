---
import Logo from './Logo.astro';

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#integrations', label: 'Integrations' },
  { href: '/#comparison', label: 'Compare' },
  { href: '/#process', label: 'Process' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header class="nav-wrap">
  <div class="container nav-inner">
    <a href="/#top" class="brand" aria-label="Own Your eCommerce home">
      <Logo height={28} label="" />
    </a>

    <nav class="nav-links" id="navLinks" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-tools">
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode" type="button">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0110 4a8 8 0 1010 10.5z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4 1.4" stroke-linecap="round"/>
        </svg>
      </button>
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
    </div>

    <div class="nav-cta">
      <a href="/#contact" class="btn btn-ghost ghost-cta">Talk to us</a>
      <a href="/#contact" class="btn btn-primary">
        Start a project
        <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('.nav-wrap');
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
  const linksEl = document.querySelector('.nav-links');
  const themeBtn = document.getElementById('themeToggle');

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 12) nav.classList.add('is-scrolled');
    else nav.classList.remove('is-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = linksEl?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
    toggle.classList.toggle('is-open', !!open);
  });

  linksEl?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      linksEl.classList.remove('is-open');
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );

  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    const m = document.getElementById('themeColorMeta');
    if (m) m.setAttribute('content', next === 'dark' ? '#08080b' : '#ffffff');
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid transparent;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .nav-wrap.is-scrolled {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border-bottom-color: var(--border);
  }
  .nav-inner {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    column-gap: 8px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--oye-ink);
  }
  /* The logo's viewBox includes the "y" descender, so nudge it down to sit level with the links. */
  .brand :global(.oye-logo) { transform: translateY(1px); }
  .nav-links {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-inline: 16px;
  }
  .nav-links a {
    padding: 8px 12px;
    border-radius: 7px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .nav-links a:hover {
    color: var(--text);
    background: var(--bg-muted);
  }
  .nav-tools,
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    padding: 0;
  }
  .nav-toggle span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--text);
    border-radius: 1px;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-toggle.is-open span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  @media (max-width: 960px) {
    /* Brand | Start a project | tools. Equal side columns keep the button centered. */
    .nav-inner {
      grid-template-columns: 1fr auto 1fr;
      column-gap: 12px;
    }
    .brand { justify-self: start; }
    .nav-tools {
      order: 1;
      justify-self: end;
    }
    .nav-links {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 14px var(--gutter) 22px;
      background: color-mix(in srgb, var(--bg) 96%, transparent);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
    }
    .nav-links.is-open {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }
    .nav-links a {
      padding: 12px 8px;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }
    .ghost-cta { display: none; }
    .nav-toggle { display: inline-flex; }
  }

  @media (max-width: 540px) {
    .nav-cta .btn-primary {
      padding: 0 14px;
      height: 36px;
      font-size: 0.85rem;
    }
  }
</style>
