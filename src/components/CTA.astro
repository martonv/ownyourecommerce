---
import { site } from '../data/site';
---

<section class="section cta" id="contact">
  <div class="container">
    <div class="cta-card" data-reveal>
      <div class="cta-aurora" aria-hidden="true"></div>
      <div class="cta-inner">
        <span class="eyebrow">Get started</span>
        <h2>Stop paying rent on your <span class="text-accent">own storefront</span></h2>
        <p class="lead">
          Tell us about your store, your stack, and where you want to be in twelve months.
          We'll come back with a fixed scope, a fixed price, and the math on what you'd save.
        </p>

        <form
          class="cta-form"
          id="contactForm"
          action={`https://formspree.io/f/${site.formspreeId}`}
          method="POST"
          data-fallback-email={site.email}
        >
          <input type="hidden" name="_subject" value={`New project inquiry from ${Astro.site?.host}`} />
          <label class="field">
            <span>Your name</span>
            <input type="text" name="name" autocomplete="name" placeholder="Jane Doe" required />
          </label>
          <label class="field">
            <span>Work email</span>
            <input type="email" name="email" autocomplete="email" placeholder="jane@yourstore.com" required />
          </label>
          <label class="field">
            <span>Current website</span>
            <input type="text" name="website" inputmode="url" autocomplete="url" placeholder="yourstore.com" />
          </label>
          <label class="field">
            <span>Platform and monthly revenue</span>
            <input type="text" name="platform" placeholder="e.g. Shopify Plus, ~$120k/mo" />
          </label>
          <label class="field full">
            <span>What do you want built?</span>
            <textarea name="message" rows="3" placeholder="A custom store with multi-warehouse inventory, work orders for our shop, a wholesale CRM, and QuickBooks sync..."></textarea>
          </label>
          <label class="honeypot" aria-hidden="true">
            Leave this field empty
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </label>
          <div class="cta-actions">
            <button type="submit" class="btn btn-accent btn-lg send-btn">
              <span class="send-label">Send request</span>
              <svg class="arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <span class="micro">No sales calls. A real reply within 1 business day.</span>
          </div>
          <p class="form-status" role="status" aria-live="polite" hidden></p>
          <p class="consent">
            We only use your details to reply to your request. See our <a href="/privacy">privacy policy</a>.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const btn = form?.querySelector('.send-btn') as HTMLButtonElement | null;
  const label = form?.querySelector('.send-label') as HTMLElement | null;
  const status = form?.querySelector('.form-status') as HTMLElement | null;

  // Unhide the live region first and write to it on the next frame; screen readers
  // routinely miss text set while the element is still hidden.
  const showStatus = (message: string, tone: 'ok' | 'error') => {
    if (!status) return;
    status.dataset.tone = tone;
    status.hidden = false;
    // a timeout, not requestAnimationFrame: rAF does not fire while the tab is in the background
    setTimeout(() => {
      status.textContent = message;
    }, 50);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !label || !status) return;
    btn.disabled = true;
    label.textContent = 'Sending…';
    status.hidden = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`Form endpoint responded ${res.status}: ${await res.text()}`);
      form.reset();
      btn.disabled = false;
      label.textContent = 'Send request';
      showStatus("Thanks. We'll be in touch within 1 business day.", 'ok');
    } catch (err) {
      console.error(err);
      btn.disabled = false;
      label.textContent = 'Send request';
      showStatus(`Sorry, your message didn't send. Please try again, or email us at ${form.dataset.fallbackEmail}.`, 'error');
    }
  });
</script>

<style>
  .cta { background: var(--bg); }
  .cta-card {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-subtle) 100%);
    padding: clamp(36px, 6vw, 64px);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .cta-aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .cta-aurora::before {
    content: '';
    position: absolute;
    width: 500px; height: 500px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: var(--aurora-opacity);
    background: radial-gradient(circle, var(--aurora-1) 0%, transparent 70%);
    top: -180px; right: -120px;
  }
  .cta-aurora::after {
    content: '';
    position: absolute;
    width: 420px; height: 420px;
    border-radius: 50%;
    filter: blur(70px);
    opacity: calc(var(--aurora-opacity) * 0.8);
    background: radial-gradient(circle, var(--aurora-2) 0%, transparent 70%);
    bottom: -160px; left: -140px;
  }
  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .cta-inner h2 { max-width: 18ch; }
  .cta-inner .lead { text-align: center; }

  .cta-form {
    margin-top: 28px;
    width: 100%;
    max-width: 620px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }
  .field.full { grid-column: 1 / -1; }
  .field span {
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .field input,
  .field textarea {
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 10px 12px;
    outline: none;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
    resize: vertical;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--accent-strong);
    box-shadow: 0 0 0 3px var(--accent-border);
    outline: none;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--text-tertiary);
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cta-actions {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .send-btn:disabled {
    opacity: 0.7;
    cursor: default;
    transform: none;
  }
  .send-btn:disabled .arrow { display: none; }
  .micro {
    font-size: 0.8rem;
    color: var(--text-tertiary);
  }
  .form-status {
    grid-column: 1 / -1;
    margin: 2px 0 0;
    font-size: 0.88rem;
    text-align: left;
  }
  .form-status[data-tone='ok'] { color: var(--success); }
  .form-status[data-tone='error'] { color: var(--danger); }
  .consent {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-tertiary);
    text-align: left;
  }
  .consent a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 600px) {
    .cta-form { grid-template-columns: 1fr; }
  }
</style>
