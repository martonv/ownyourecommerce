---
import { site } from '../data/site';

// COPY.md §11. The founder's first name is still [TODO], so the line under the button omits it.
const tools = ['Shopify', 'HubSpot', 'Fishbowl', 'QuickBooks', 'Other'];
---

<section class="section cta" id="contact">
  <div class="container">
    <div class="head" data-reveal>
      <h2>See your stack as one system.</h2>
      <p class="lead">
        Tell us what you run today. We'll come back with a map of how it fits together and what it
        would take to make it one system.
      </p>
    </div>

    <div class="card" data-reveal>
      <form
        class="form"
        id="contactForm"
        action={`https://formspree.io/f/${site.formspreeId}`}
        method="POST"
        data-fallback-email={site.email}
      >
        <input type="hidden" name="_subject" value={`New stack review request from ${Astro.site?.host}`} />

        <label class="field">
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required placeholder="Dana Whitfield" />
        </label>

        <label class="field">
          <span>Work email</span>
          <input type="email" name="email" autocomplete="email" required placeholder="dana@yourcompany.com" />
        </label>

        <label class="field full">
          <span>Company website</span>
          <input type="url" name="website" autocomplete="url" placeholder="yourcompany.com" />
        </label>

        <fieldset class="field full tools">
          <legend>Current tools</legend>
          <div class="chips">
            {tools.map((tool) => (
              <label class="chip">
                <input type="checkbox" name="tools" value={tool} />
                <span>{tool}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="field full">
          <span>What breaks most often?</span>
          <textarea name="breaks" rows="3" placeholder="Stock counts drift between Fishbowl and Shopify, and wholesale orders get retyped."></textarea>
        </label>

        <label class="honeypot" aria-hidden="true">
          Leave this field empty
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>

        <div class="actions">
          <button type="submit" class="btn btn-primary send-btn">
            <span class="send-label">Book my stack review</span>
          </button>
          <span class="micro">A real reply within one business day. No sales sequence.</span>
        </div>

        <p class="form-status" role="status" aria-live="polite" hidden></p>
        <p class="consent">
          We only use your details to reply to your request. See our <a href="/privacy">privacy policy</a>.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const btn = form?.querySelector('.send-btn') as HTMLButtonElement | null;
  const label = form?.querySelector('.send-label') as HTMLElement | null;
  const status = form?.querySelector('.form-status') as HTMLElement | null;

  // Unhide the live region first and write to it a tick later; screen readers routinely miss
  // text set while the element is still hidden.
  const showStatus = (message: string, tone: 'ok' | 'error') => {
    if (!status) return;
    status.dataset.tone = tone;
    status.hidden = false;
    setTimeout(() => {
      status.textContent = message;
    }, 50);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !label || !status) return;
    btn.disabled = true;
    label.textContent = 'Sending…';
    status.hidden = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(`Form endpoint responded ${res.status}: ${await res.text()}`);
      form.reset();
      btn.disabled = false;
      label.textContent = 'Book my stack review';
      showStatus("Thanks. We'll be in touch within one business day.", 'ok');
    } catch (err) {
      console.error(err);
      btn.disabled = false;
      label.textContent = 'Book my stack review';
      showStatus(`Sorry, that didn't send. Please try again, or email us at ${form.dataset.fallbackEmail}.`, 'error');
    }
  });
</script>

<style>
  .cta { background: var(--bg); }

  .head {
    max-width: 640px;
    margin: 0 auto clamp(32px, 4vw, 48px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .head h2 { max-width: 20ch; }
  .head .lead { max-width: 56ch; }

  .card {
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(24px, 3vw, 32px);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .field.full { grid-column: 1 / -1; }
  .field > span,
  .tools legend {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-body);
  }

  input[type='text'],
  input[type='email'],
  input[type='url'],
  textarea {
    width: 100%;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--bg-muted);
    border: 1px solid transparent;
    border-radius: var(--radius);
    padding: 9px 12px;
    outline: none;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
    resize: vertical;
  }
  input[type='text'],
  input[type='email'],
  input[type='url'] { height: 40px; }
  input::placeholder,
  textarea::placeholder { color: var(--text-muted); }
  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
    outline: none;
  }

  .tools {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; }
  .chip input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.8125rem;
    color: var(--text-body);
    cursor: pointer;
    transition: background 0.15s var(--ease), border-color 0.15s var(--ease), color 0.15s var(--ease);
  }
  .chip input:checked + span {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent-strong);
    font-weight: 500;
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .actions .btn { width: 100%; }
  .micro {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
  }

  .form-status {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.875rem;
  }
  .form-status[data-tone='ok'] { color: var(--accent-strong); }
  .form-status[data-tone='error'] { color: var(--danger); }

  .consent {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .consent a {
    color: var(--text-body);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 560px) {
    .form { grid-template-columns: 1fr; }
  }
</style>
