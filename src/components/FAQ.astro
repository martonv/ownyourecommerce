---
// COPY.md §10. The "who owns the code and data" question is deliberately not here.
const faqs = [
  {
    q: 'Do we have to leave our current platform?',
    a: 'No. Many clients keep the storefront they have, whether that is Shopify, WooCommerce, BigCommerce, Magento or something custom, and replace what sits behind it: the inventory system, the CRM and the connectors holding them together. We recommend whichever is cheaper and simpler for you.',
  },
  {
    q: 'Can we keep software we already use?',
    a: 'Yes. If a tool earns its place, we connect to it instead of replacing it. Anything with an API can stay: your accounting, your email platform, your 3PL, your CRM. We will tell you honestly which ones are worth keeping.',
  },
  {
    q: 'How do you migrate our existing data?',
    a: 'We export items, locations, bills of materials, open orders and history from whatever you run today, then run both systems side by side until the counts match. You do not switch over until they do.',
  },
  {
    q: 'What does it cost after launch?',
    a: 'Ongoing development is optional: a monthly retainer, or project by project. Nothing renews on its own.',
  },
  {
    q: 'How long does it take?',
    a: 'Most consolidation projects take 8–16 weeks. You\'ll see working software in the first few weeks and every week after.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section faq" id="faq">
  <div class="container grid">
    <div class="head" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2>Questions we get asked.</h2>
    </div>

    <div class="list" data-reveal>
      {faqs.map((f, i) => (
        <div class="item">
          <h3>
            <button type="button" aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`} data-faq>
              <span>{f.q}</span>
              <span class="icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="answer" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
            <div class="answer-inner">
              <p>{f.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-faq]')) {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      btn.closest('.item')?.classList.toggle('is-open', !open);
    });
  }
</script>

<style>
  .faq { background: var(--bg); border-top: 1px solid var(--border); }

  .grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .head {
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .list { border-top: 1px solid var(--border); }
  .item { border-bottom: 1px solid var(--border); }
  .item h3 { margin: 0; font-size: inherit; letter-spacing: 0; }

  .item button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border: 0;
    background: transparent;
    text-align: left;
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
  }
  .item button:hover { color: var(--text-body); }

  .icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    transition: transform 0.2s var(--ease);
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: var(--text-muted);
  }
  .icon::after { transform: rotate(90deg); }
  .is-open .icon { transform: rotate(45deg); }

  .answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.2s var(--ease);
  }
  .is-open .answer { grid-template-rows: 1fr; }
  .answer-inner {
    overflow: hidden;
    /* keeps links inside a closed answer out of the tab order */
    visibility: hidden;
  }
  .is-open .answer-inner { visibility: visible; }
  .answer p {
    padding-bottom: 18px;
    font-size: 0.9375rem;
    color: var(--text-body);
  }

  @media (max-width: 1024px) {
    .grid { grid-template-columns: 1fr; }
    .head { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .answer, .icon { transition: none; }
  }
</style>
