---
// COPY.md §6. Plain text in both columns, no check or cross icons.
const rows = [
  { label: 'Software licenses', them: '3+ subscriptions, renewing', us: 'None. You own it' },
  { label: 'Per-seat pricing', them: 'CRM and ERP seats add up as you hire', us: 'Unlimited users' },
  { label: 'Keeping systems in sync', them: 'Connectors and manual fixes', us: 'One database, no sync' },
  { label: 'Fit to your process', them: 'You adapt to the software', us: 'Built around your workflow' },
  { label: 'Your data', them: 'Split across three vendors', us: 'In one place you can query' },
  { label: 'Ongoing costs', them: 'Rises with seats, orders and apps', us: 'An optional support retainer' },
];
---

<section class="section compare" id="compare">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">The math</p>
      <h2>Stop paying rent on your own operations.</h2>
      <p class="lead">
        A typical storefront, CRM and inventory stack is three renewals, per-seat pricing and a
        connector bill. Here's how that compares.
      </p>
    </div>

    <div class="table-wrap" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Comparison</span></th>
            <th scope="col">Your current stack</th>
            <th scope="col" class="ours">Own Your eCommerce</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td data-col="Your current stack">{r.them}</td>
              <td class="ours" data-col="Own Your eCommerce">{r.us}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .compare {
    background: var(--bg-subtle);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  /* No scroll container here on purpose: it would capture the sticky header
     and push it away from the page. Under 760px the table becomes cards instead. */
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg);
    border: 1px solid var(--border);
    border-spacing: 0;
    /* No overflow or radius here: either one would make the table a scroll container
       and the sticky header would offset itself inside it instead of against the page. */
  }

  thead th {
    position: sticky;
    top: 64px;
    z-index: 1;
    background: var(--bg);
    text-align: left;
    padding: 14px 20px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }
  thead th.ours {
    color: var(--accent-strong);
    font-weight: 600;
    background: var(--accent-soft);
    border-top: 1px solid var(--accent);
  }

  tbody th {
    text-align: left;
    font-weight: 500;
    color: var(--text);
  }
  tbody th,
  tbody td {
    padding: 16px 20px;
    font-size: 0.9375rem;
    color: var(--text-body);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  tbody tr:last-child th,
  tbody tr:last-child td { border-bottom: 0; }

  td.ours {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Stacked cards, one per row (DESIGN.md §6) */
  @media (max-width: 760px) {
    table {
      border: 0;
      background: transparent;
    }
    thead { display: none; }
    tbody, tbody tr, tbody th, tbody td { display: block; }
    tbody tr {
      margin-bottom: 10px;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--bg);
      overflow: hidden;
    }
    tbody th {
      padding: 14px 16px 6px;
      border-bottom: 0;
      font-size: 0.9375rem;
    }
    tbody td {
      padding: 6px 16px 12px;
      border-bottom: 0;
      font-size: 0.875rem;
    }
    tbody td::before {
      content: attr(data-col);
      display: block;
      margin-bottom: 2px;
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
    }
    tbody td.ours {
      padding-top: 10px;
      border-top: 1px solid var(--accent);
    }
  }
</style>
