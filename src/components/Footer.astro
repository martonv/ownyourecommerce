---
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/#demo', label: 'Demo' },
      { href: '/#systems', label: 'Systems' },
      { href: '/#custom', label: 'Custom builds' },
      { href: '/#integrations', label: 'Integrations' },
      { href: '/#comparison', label: 'Compare' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/#process', label: 'Process' },
      { href: '/#faq', label: 'FAQ' },
      { href: '/#contact', label: 'Contact' },
    ],
  },
  {
    title: 'Trust',
    links: [
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
      { href: '/cookies', label: 'Cookies' },
      { href: '/security', label: 'Security' },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="brand-block">
      <a href="/#top" class="brand" aria-label="Own Your eCommerce home">
        <Logo height={24} label="" />
      </a>
      <p class="brand-tag">
        Custom stores. No monthly fees. Forever yours.
      </p>
      <div class="status">
        <span class="dot"></span>
        All systems operational
      </div>
    </div>

    <div class="cols">
      {cols.map((c) => (
        <div class="col">
          <div class="col-title">{c.title}</div>
          <ul>
            {c.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <hr class="divider" />

  <div class="container footer-base">
    <div class="copy">© {year} Own Your eCommerce. All rights reserved.</div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 64px 0 28px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
  }
  .brand {
    display: inline-flex;
    color: var(--oye-ink);
  }
  .brand-tag {
    margin-top: 14px;
    font-size: 0.88rem;
    color: var(--text-secondary);
    max-width: 32ch;
    line-height: 1.55;
  }
  .status {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    padding: 6px 10px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .status .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px rgba(16,185,129,0.2);
  }
  .cols { display: contents; }
  .col-title {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 14px;
    font-weight: 500;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .col a {
    font-size: 0.92rem;
    color: var(--text-secondary);
    transition: color 0.15s var(--ease);
  }
  .col a:hover { color: var(--text); }

  .footer-base {
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.82rem;
    color: var(--text-tertiary);
  }

  @media (max-width: 800px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .brand-block { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
