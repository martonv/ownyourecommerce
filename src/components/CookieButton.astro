---
---

<button class="cookie-fab" id="cookieFab" aria-label="Cookie preferences" aria-haspopup="dialog" aria-expanded="false">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M12 3a9 9 0 109 9 4 4 0 01-5 5 4 4 0 01-4 4z" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="9" cy="9.5" r="0.9" fill="currentColor" stroke="none"/>
    <circle cx="14.5" cy="8" r="0.9" fill="currentColor" stroke="none"/>
    <circle cx="8.5" cy="14" r="0.9" fill="currentColor" stroke="none"/>
    <circle cx="13" cy="13.5" r="0.9" fill="currentColor" stroke="none"/>
    <circle cx="16" cy="12" r="0.9" fill="currentColor" stroke="none"/>
  </svg>
</button>

<div class="cookie-pop" id="cookiePop" role="dialog" aria-labelledby="cookiePopTitle" aria-hidden="true">
  <h4 id="cookiePopTitle">Cookie preferences</h4>
  <p>
    We use a small set of cookies to keep this site running smoothly and to understand which pages are
    helpful. You can turn them off below. Your choice is saved on this device.
  </p>
  <div class="cookie-row">
    <span class="label">Allow cookies</span>
    <label class="switch" aria-label="Toggle cookies">
      <input type="checkbox" id="cookieToggle" checked />
      <span class="track"></span>
      <span class="knob"></span>
    </label>
  </div>
  <div class="cookie-actions">
    <button type="button" class="btn btn-secondary" id="cookieSave">Save</button>
    <button type="button" class="btn btn-ghost" id="cookieClose">Close</button>
  </div>
</div>

<script>
  const fab = document.getElementById('cookieFab');
  const pop = document.getElementById('cookiePop');
  const close = document.getElementById('cookieClose');
  const save = document.getElementById('cookieSave');
  const toggle = document.getElementById('cookieToggle') as HTMLInputElement | null;

  try {
    const stored = localStorage.getItem('cookies-allowed');
    if (toggle && stored !== null) toggle.checked = stored === 'true';
  } catch {}

  const setOpen = (open: boolean) => {
    if (!pop || !fab) return;
    pop.classList.toggle('is-open', open);
    pop.setAttribute('aria-hidden', String(!open));
    fab.setAttribute('aria-expanded', String(open));
  };

  fab?.addEventListener('click', () => {
    const isOpen = pop?.classList.contains('is-open');
    setOpen(!isOpen);
  });

  close?.addEventListener('click', () => setOpen(false));

  save?.addEventListener('click', () => {
    try {
      localStorage.setItem('cookies-allowed', String(!!toggle?.checked));
    } catch {}
    setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  document.addEventListener('click', (e) => {
    if (!pop?.classList.contains('is-open')) return;
    const target = e.target as Node;
    if (pop.contains(target) || fab?.contains(target)) return;
    setOpen(false);
  });
</script>
