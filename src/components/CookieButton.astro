---
---

<button class="cookie-fab" id="cookieFab" type="button" aria-label="Cookie preferences" aria-haspopup="dialog" aria-expanded="false" aria-controls="cookiePop">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path class="cookie-dough" d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5z" />
    <g class="cookie-chips">
      <circle cx="8" cy="8.5" r="1.4" />
      <circle cx="12.5" cy="12.5" r="1.3" />
      <circle cx="16.8" cy="15.8" r="1.4" />
      <circle cx="10.8" cy="17.2" r="1.3" />
      <circle cx="6.6" cy="13.6" r="1.2" />
    </g>
    <g class="cookie-crumbs">
      <circle cx="20.4" cy="4.6" r="0.8" />
      <circle cx="22.2" cy="7.6" r="0.55" />
    </g>
  </svg>
</button>

<div class="cookie-pop" id="cookiePop" role="dialog" aria-labelledby="cookiePopTitle" aria-hidden="true">
  <h4 id="cookiePopTitle">Cookie preferences</h4>
  <p>
    This site only saves your theme and this choice on your device. We don't run analytics or ad
    trackers, and if we ever add analytics, they'll stay off unless you allow them here.
    <a href="/cookies">Read the cookie policy</a>.
  </p>
  <div class="cookie-row">
    <span class="label">Allow analytics cookies</span>
    <label class="switch" aria-label="Allow analytics cookies">
      <input type="checkbox" id="cookieToggle" />
      <span class="track"></span>
      <span class="knob"></span>
    </label>
  </div>
  <div class="cookie-actions">
    <button type="button" class="btn btn-secondary" id="cookieSave">Save</button>
    <button type="button" class="btn btn-ghost" id="cookieClose">Close</button>
  </div>
</div>

<script>
  const fab = document.getElementById('cookieFab');
  const pop = document.getElementById('cookiePop');
  const close = document.getElementById('cookieClose');
  const save = document.getElementById('cookieSave');
  const toggle = document.getElementById('cookieToggle') as HTMLInputElement | null;

  try {
    const stored = localStorage.getItem('cookies-allowed');
    if (toggle && stored !== null) toggle.checked = stored === 'true';
  } catch {}

  const setOpen = (open: boolean) => {
    if (!pop || !fab) return;
    pop.classList.toggle('is-open', open);
    pop.setAttribute('aria-hidden', String(!open));
    fab.setAttribute('aria-expanded', String(open));
  };

  fab?.addEventListener('click', () => {
    const isOpen = pop?.classList.contains('is-open');
    setOpen(!isOpen);
  });

  close?.addEventListener('click', () => setOpen(false));

  save?.addEventListener('click', () => {
    try {
      localStorage.setItem('cookies-allowed', String(!!toggle?.checked));
    } catch {}
    setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  document.addEventListener('click', (e) => {
    if (!pop?.classList.contains('is-open')) return;
    const target = e.target as Node;
    if (pop.contains(target) || fab?.contains(target)) return;
    setOpen(false);
  });
</script>
