---
const steps = [
  {
    n: '01',
    title: 'Discovery',
    body: 'We map your catalog, checkout flow, fulfillment, accounting, and edge cases. Then we scope a build around how your business actually operates.',
  },
  {
    n: '02',
    title: 'Architecture and design',
    body: 'No templates. We design your store interface and architect a custom Astro front end with the integrations you need wired in at the foundation.',
  },
  {
    n: '03',
    title: 'Build',
    body: 'Storefront, checkout, admin, integrations, built in modern Astro, HTML, CSS, and JavaScript. Reviewed weekly. Iterated continuously.',
  },
  {
    n: '04',
    title: 'Migrate',
    body: 'Products, customers, orders, SEO redirects, and historical data moved from your existing platform with zero downtime and zero data loss.',
  },
  {
    n: '05',
    title: 'Launch on the host you choose',
    body: 'Cloudflare, AWS, Vercel, Netlify, or any DNS host you already use. We deploy to whatever infrastructure you prefer and keep you in control of your domain. Subsecond page loads, DDoS protection, and automatic SSL come standard.',
  },
  {
    n: '06',
    title: 'Maintain and evolve',
    body: 'Continuous development. New features, performance work, integrations, and security updates shipped by the team that built it, month after month.',
  },
];
---

<section class="section process" id="process">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Process</span>
      <h2>From rented platform to <span class="text-gradient">owned business</span></h2>
      <p class="lead" style="text-align:center;">
        A clear path from your first Shopify invoice to a store that's yours.
      </p>
    </div>

    <ol class="steps">
      {steps.map((s) => (
        <li class="step" data-reveal>
          <div class="step-num">{s.n}</div>
          <div class="step-body">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { background: var(--bg); }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    position: relative;
  }

  .step {
    position: relative;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .step:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    width: fit-content;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 14px;
    letter-spacing: 0.04em;
  }
  .step h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }
  .step p {
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 880px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
