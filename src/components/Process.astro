---
const steps = [
  {
    n: '01',
    title: 'Discovery',
    body: 'We map your catalog, checkout, warehouse, production, and customer workflows, edge cases included. Then we scope a build around how your business actually operates.',
  },
  {
    n: '02',
    title: 'Architecture and design',
    body: 'No templates. We design your store interface and architect a custom front end on a modern stack, with the integrations you need wired in at the foundation.',
  },
  {
    n: '03',
    title: 'Build',
    body: 'Storefront, checkout, admin, and integrations, built on modern tech stacks like Next.js, React, TypeScript, and headless commerce APIs. Reviewed weekly. Iterated continuously.',
  },
  {
    n: '04',
    title: 'Migrate',
    body: 'Products, customers, orders, SEO redirects, and historical data moved from your existing platform with zero downtime and zero data loss.',
  },
  {
    n: '05',
    title: 'Launch on the host you choose',
    body: 'Cloudflare, AWS, Vercel, Netlify, or any DNS host you already use. We deploy to whatever infrastructure you prefer and keep you in control of your domain. Subsecond page loads, DDoS protection, and automatic SSL come standard.',
  },
  {
    n: '06',
    title: 'Maintain and evolve',
    body: 'Continuous development. New features, performance work, integrations, and security updates shipped by the team that built it, month after month.',
  },
];
---

<section class="section process" id="process">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Process</span>
      <h2>From rented platform to <span class="text-accent">owned business</span></h2>
      <p class="lead">
        A clear path from your first Shopify invoice to a store that's yours.
      </p>
    </div>

    <ol class="steps">
      {steps.map((s) => (
        <li class="step" data-reveal>
          <div class="step-num">{s.n}</div>
          <div class="step-body">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { background: var(--bg); }

  /* One column threaded on a vertical rule, so the process reads as a sequence. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 720px;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 32px 1fr;
    column-gap: 20px;
    padding-bottom: 34px;
  }
  .step:last-child { padding-bottom: 0; }
  .step::before {
    content: '';
    position: absolute;
    left: 15.5px;
    top: 38px;
    bottom: 4px;
    width: 1px;
    background: var(--border-strong);
  }
  .step:last-child::before { display: none; }

  .step-num {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    border-radius: 50%;
    letter-spacing: 0.02em;
  }
  .step-body { padding-top: 3px; }
  .step h3 {
    font-size: 1.05rem;
    margin-bottom: 6px;
  }
  .step p {
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 62ch;
  }

  @media (max-width: 560px) {
    .step { column-gap: 14px; }
    .step p { font-size: 0.9rem; }
  }
</style>
