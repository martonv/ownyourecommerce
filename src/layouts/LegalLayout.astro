---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** ISO date (YYYY-MM-DD) shown as "Last updated". */
  updated: string;
  eyebrow?: string;
  toc?: { id: string; label: string }[];
}

const { title, description, updated, eyebrow = 'Legal', toc = [] } = Astro.props;

const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const pages = [
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
  { href: '/cookies', label: 'Cookie Policy' },
  { href: '/security', label: 'Security' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<Layout title={`${title} | ${site.name}`} description={description}>
  <Nav />
  <main class="legal">
    <header class="legal-head">
      <div class="container legal-head-inner">
        <span class="eyebrow">{eyebrow}</span>
        <h1>{title}</h1>
        <p class="legal-updated">Last updated <time datetime={updated}>{updatedLabel}</time></p>
      </div>
    </header>

    <div class="container legal-grid">
      <aside class="legal-aside">
        <nav class="legal-pages" aria-label="Legal pages">
          {pages.map((p) => (
            <a href={p.href} aria-current={p.href === current ? 'page' : undefined}>{p.label}</a>
          ))}
        </nav>
        {toc.length > 0 && (
          <nav class="legal-toc" aria-label="On this page">
            <span class="legal-toc-title">On this page</span>
            {toc.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
          </nav>
        )}
      </aside>

      <article class="prose">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal-head {
    padding: clamp(48px, 7vw, 88px) 0 clamp(32px, 4vw, 48px);
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }
  .legal-head-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .legal-head h1 { font-size: clamp(2.25rem, 4.5vw, 3.25rem); }
  .legal-updated {
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }

  .legal-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(40px, 6vw, 88px);
    padding-block: clamp(40px, 6vw, 72px) clamp(72px, 9vw, 120px);
  }
  .legal-aside {
    position: sticky;
    top: 88px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .legal-pages,
  .legal-toc {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .legal-pages a,
  .legal-toc a {
    padding: 6px 10px;
    border-radius: 7px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .legal-pages a:hover,
  .legal-toc a:hover {
    color: var(--text);
    background: var(--bg-muted);
  }
  .legal-pages a[aria-current='page'] {
    color: var(--text);
    font-weight: 500;
    background: var(--accent-soft);
  }
  .legal-toc-title {
    padding: 0 10px 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .prose { max-width: 68ch; }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(h2) {
    font-size: 1.375rem;
    margin: 48px 0 14px;
    scroll-margin-top: 88px;
  }
  .prose :global(h3) {
    font-size: 1.05rem;
    margin: 28px 0 10px;
  }
  .prose :global(p),
  .prose :global(li) {
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .prose :global(p) { margin: 0 0 14px; }
  .prose :global(ul) {
    margin: 0 0 18px;
    padding-left: 1.25em;
  }
  .prose :global(li) { margin: 6px 0; }
  .prose :global(li::marker) { color: var(--text-tertiary); }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s var(--ease);
  }
  .prose :global(a:hover) { text-decoration-color: var(--text); }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--bg-muted);
    color: var(--text);
  }
  .prose :global(.callout) {
    margin: 0 0 36px;
    padding: 18px 20px;
    border: 1px solid var(--accent-border);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }
  .prose :global(.callout p) { margin: 0; }
  .prose :global(.table-wrap) {
    overflow-x: auto;
    margin: 0 0 18px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
  }
  .prose :global(th) {
    color: var(--text);
    font-weight: 600;
    background: var(--bg-subtle);
  }
  .prose :global(tr:last-child td) { border-bottom: 0; }
  .prose :global(td code) { white-space: nowrap; }

  @media (max-width: 860px) {
    .legal-grid { grid-template-columns: 1fr; }
    .legal-aside { position: static; }
    .legal-pages {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
    }
    .legal-pages a {
      padding: 6px 12px;
      border: 1px solid var(--border-strong);
      border-radius: 999px;
    }
    .legal-toc { display: none; }
  }
</style>
