---
import CookieButton from '../components/CookieButton.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Own Your eCommerce. Custom stores. No monthly fees. Forever yours.',
  description = 'Custom eCommerce stores with built-in inventory, production, and CRM systems. Zero monthly fees, total code ownership, Helcim payments, and FedEx and UPS shipping. Escape Wix and Shopify.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/oye-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" id="themeColorMeta" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored || 'light';
          document.documentElement.setAttribute('data-theme', theme);
          var m = document.getElementById('themeColorMeta');
          if (m) m.setAttribute('content', theme === 'dark' ? '#08080b' : '#ffffff');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <CookieButton />

    <script>
      const reveal = () => {
        const els = document.querySelectorAll('[data-reveal]');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      };

      if (document.readyState !== 'loading') reveal();
      else document.addEventListener('DOMContentLoaded', reveal);
    </script>

    <style is:global>
      @import '../styles/global.css';
    </style>
  </body>
</html>
